# Copy this file to .env and fill in your own values before running locally.
# On Render, set these as Environment Variables in the service dashboard instead
# (Settings tab in your web service).

# Port the API listens on
PORT=4000

# Secret admin token used ONLY by your Electron control panel to manage sites.
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- Persistent storage via GitHub (recommended) ----
# Without these, the server falls back to a local JSON file, which Render's
# free tier WIPES on every redeploy or container restart. Setting these
# makes your site list survive that by storing it in your GitHub repo.

# A GitHub Personal Access Token with permission to write to GITHUB_REPO.
# Fine-grained token: scope it to just this repo, with "Contents: Read and write".
# Classic token: needs the "repo" scope.
GITHUB_TOKEN=

# The repo where the data file lives, as "owner/repo" — e.g. Hani19982017/killer
GITHUB_REPO=

# Path to the JSON file inside that repo. Defaults to data.json (repo root)
# if you leave this unset. If your server code lives in a "server/" folder
# in the repo, you may want this to be server/data.json instead.
GITHUB_FILE_PATH=data.json

# Branch to read/write. Defaults to "main" if unset.
GITHUB_BRANCH=main
